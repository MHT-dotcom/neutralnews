# Sample .env file - Copy to .env and fill in your API keys
# News API keys - at least one of these is required for the app to show results
NEWSAPI_ORG_KEY=your_newsapi_org_key_here
GUARDIAN_API_KEY=your_guardian_api_key_here
GNEWS_API_KEY=your_gnews_api_key_here
NYT_API_KEY=your_nyt_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
MEDIASTACK_API_KEY=your_mediastack_api_key_here
NEWSDATA_API_KEY=your_newsdata_api_key_here
AYLIEN_APP_ID=your_aylien_app_id_here
AYLIEN_API_KEY=your_aylien_api_key_here

# Port configuration (optional)
PORT=10000

# Debug mode (optional)
DEBUG=False 